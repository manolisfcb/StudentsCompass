# Copy to config.env and fill in. config.env is git-ignored: it names a project
# and its identities, which is not a secret but is not this repository's
# business either.
#
# No value here is a credential. The whole point of TASK-055 is that the only
# credentials involved are minted on demand — by Workload Identity Federation
# for CI, and by Cloud Run for the service accounts at runtime.

# --- Project and region ----------------------------------------------------
PROJECT_ID="studentscompass"
REGION="us-central1"

# --- Artifact Registry -----------------------------------------------------
REPOSITORY="studentscompass"

# --- GitHub repository allowed to deploy -----------------------------------
# Exactly one repository. The WIF binding is scoped to this string; widening it
# to the whole org would let any repository in it deploy to production.
GITHUB_REPOSITORY="manolisfcb/StudentsCompass"

# --- Service names ---------------------------------------------------------
API_SERVICE="studentscompass-api"
FRONT_SERVICE="studentscompass-front"
MIGRATE_JOB="studentscompass-migrate"
TASKS_QUEUE="studentscompass-cv-analysis"
